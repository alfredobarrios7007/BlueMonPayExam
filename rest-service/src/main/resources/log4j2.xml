<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <RollingFile name="MntCustomDataFile"
                     fileName="${env:MNT_CUSTOM_DATA_LOG_DIR:-logs}/mntCustomData.log"
                     filePattern="${env:MNT_CUSTOM_DATA_LOG_DIR:-logs}/mntCustomData-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS}|B2|%msg%n" />
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10 MB" />
            </Policies>
            <DefaultRolloverStrategy max="30" />
        </RollingFile>
    </Appenders>
    <Loggers>
        <Logger name="mntCustomDataAudit" level="info" additivity="false">
            <AppenderRef ref="MntCustomDataFile" />
        </Logger>
        <Root level="off" />
    </Loggers>
</Configuration>
